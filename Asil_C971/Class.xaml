<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Asil_C971.Class"
             Title="Course Details" HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto, *, Auto" Padding="15" BackgroundColor="LightGray">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto" RowDefinitions="Auto, Auto" RowSpacing="5" Margin="0,0,0,10">
            <Button Grid.Column="0" Grid.RowSpan="2" Text="Notify me" VerticalOptions="Center" Clicked="notifyMe" />
            
            <Label Grid.Row="0" Grid.Column="2" Text="Start:" VerticalOptions="Center" TextColor="Black" />
            <DatePicker Grid.Row="0" Grid.Column="3" Date="{Binding Start}" Format="yyyy-MM-dd" TextColor="Black" />
            <Label Grid.Row="1" Grid.Column="2" Text="Due:" VerticalOptions="Center" TextColor="Black" />
            <DatePicker Grid.Row="1" Grid.Column="3" Date="{Binding End}" Format="yyyy-MM-dd" TextColor="Black" />

            <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Text="Status:" VerticalOptions="Center" TextColor="Black" Margin="10,0,0,0" />
            <Picker Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" SelectedItem="{Binding Status}" Title="Status"  TextColor="Black" WidthRequest="90" VerticalOptions="Center">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>In Progress</x:String>
                        <x:String>Completed</x:String>
                        <x:String>Dropped</x:String>
                        <x:String>Plan to Take</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" RowSpacing="20">
            <Border Grid.Row="0" Stroke="Gray" StrokeThickness="1" Padding="15" BackgroundColor="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <StackLayout Spacing="10">
                    <Label Text="Instructor:" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                    <Entry Text="{Binding ProfName}" Placeholder="Name" TextColor="Black" />
                    <Entry Text="{Binding profPhone}" Placeholder="Phone" Keyboard="Telephone" TextColor="Black" />
                    <Entry Text="{Binding profEmail}" Placeholder="Email" Keyboard="Email" TextColor="Black" />
                </StackLayout>
            </Border>

            <Border Grid.Row="1" Stroke="Gray" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="120">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Grid>
                    <Editor Text="{Binding Notes}" Placeholder="Notes..." Margin="10" TextColor="Black" />
                    <Button Text="Share" x:Name="ShareBtn" Clicked="shareClick" 
                            HorizontalOptions="End" VerticalOptions="End" 
                            Margin="5" Padding="10,0" HeightRequest="35" 
                            BackgroundColor="Black" TextColor="White" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="*, Auto">

                <CollectionView x:Name="testsView" Grid.Row="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="Blue" StrokeThickness="1" Padding="1" Margin="0,1" BackgroundColor="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <RadioButton Grid.Column="0" VerticalOptions="Center" CheckedChanged="Checked" />

                                    <Entry Grid.Column="1" Text="{Binding Title}" TextColor="Black" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" Completed="testEdited" Unfocused="testEdited"/>

                                    <StackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" Margin="2,0">
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="Start:" TextColor="Black" VerticalOptions="Center" FontSize="12" Margin="0,0,5,0"/>
                                            <DatePicker Date="{Binding Start}" TextColor="Black" Format="yyyy-MM-dd" DateSelected="testEdited" HeightRequest="32" FontSize="12" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="Due:" TextColor="Black" VerticalOptions="Center" FontSize="12" Margin="0,0,11,0"/>
                                            <DatePicker Date="{Binding End}" TextColor="Black" Format="yyyy-MM-dd" DateSelected="testEdited" HeightRequest="32" FontSize="12" />
                                        </StackLayout>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Entry Grid.Row="2" Text="{Binding Title}"
                   TextColor="Black" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Start" VerticalOptions="End" />
        <StackLayout Grid.Row="2" Orientation="Horizontal" HorizontalOptions="End" Spacing="10">
            <Button Text="Delete" BackgroundColor="White" TextColor="Black" Clicked="delbtn" />
            <Button Text="Add" BackgroundColor="White" TextColor="Black" Clicked="add" />
            <Button Text="Save" BackgroundColor="White" TextColor="Black" Clicked="save" />
        </StackLayout>

    </Grid>
</ContentPage>